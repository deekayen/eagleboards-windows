<Window x:Class="EagleBoards.App.QrWindow"
        Icon="pack://application:,,,/EagleBoards;component/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EagleBoards.App"
        Title="Check-in QR codes - Eagle Board Scheduler" Width="420" MinWidth="360" Height="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Point a tablet's camera here" />
      <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,16"
                 Text="Opens the check-in website without typing the address in by hand. If the venue has more than one network, use the code for the one the tablet is on." />
      <ItemsControl x:Name="CodeList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type app:QrCode}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel HorizontalAlignment="Center">
                <Image Source="{Binding Image}" Width="240" Height="240" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Url, StringFormat=QR code for {0}}" />
                <TextBlock Text="{Binding Url}" Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Window>
