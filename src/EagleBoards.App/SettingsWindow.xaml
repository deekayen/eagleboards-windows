<Window x:Class="EagleBoards.App.SettingsWindow"
        Icon="pack://application:,,,/EagleBoards;component/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Eagle Board Scheduler" Width="880" Height="760" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <!-- File > Settings, and Help > Donate at the Support card (SPEC.md D-17).
       A window of its own, so the Event page stays in view beside it. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ContentControl x:Name="Host" Margin="24,16,24,8" Focusable="False" />
  </ScrollViewer>
</Window>
