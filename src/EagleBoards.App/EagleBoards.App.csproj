<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF0001: ThemeMode, which loads the Fluent (Windows 11) theme, is
         still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <RootNamespace>EagleBoards.App</RootNamespace>
    <AssemblyName>EagleBoards</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Eagle rank patch; drawn in Assets/EagleBoards.svg, packed by scripts/make-icon.sh. -->
    <ApplicationIcon>Assets\EagleBoards.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -r win-x64 gives one self-contained EagleBoards.exe:
       no .NET install needed on the admin computer, nothing to unpack. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EagleBoards.Web\EagleBoards.Web.csproj" />
  </ItemGroup>

  <!-- Also a WPF resource, so every window's title bar and taskbar button show it. -->
  <ItemGroup>
    <Resource Include="Assets\EagleBoards.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EagleBoards.UiSnapshots" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
