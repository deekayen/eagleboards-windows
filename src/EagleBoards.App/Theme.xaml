<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="PanelBorder" Color="#B6B0A4" />
  <SolidColorBrush x:Key="PanelHeader" Color="#E9E9E4" />
  <SolidColorBrush x:Key="Ink" Color="#232528" />

  <Style x:Key="PanelTitle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelHeader}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style x:Key="Panel" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="White" />
  </Style>

  <Style x:Key="ToolButton" TargetType="Button">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinWidth" Value="56" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#E6E2DA" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="Background" Value="White" />
  </Style>

</ResourceDictionary>
