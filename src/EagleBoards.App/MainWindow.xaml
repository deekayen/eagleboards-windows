<Window x:Class="EagleBoards.App.MainWindow"
        Icon="pack://application:,,,/EagleBoards;component/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EagleBoards.App"
        Title="Eagle Board Scheduler" Width="1400" Height="900" MinWidth="1100" MinHeight="640"
        WindowState="Maximized">

  <!-- A menu bar on the window's base layer, and the page on a content layer
       below it. Event is the console: the youth queue, the rooms, and a
       details pane that builds and runs the selected youth's board (the
       list/details pattern). Results and People are the other pages, from
       the View menu; Settings, Admin tables and Help open windows of their own. -->

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Status as a tinted label with an icon, in the shared status palette
         (StatusPalette, SPEC.md D-13): the words carry the meaning, the icon
         and tint help scanning, and none of it relies on colour alone. -->
    <DataTemplate x:Key="StatusCell" DataType="{x:Type app:ScoutRow}">
      <Border x:Name="Pill" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center"
              BorderThickness="1" BorderBrush="{DynamicResource StatusBorderBrush}"
              Background="{DynamicResource StatusNeutralBackgroundBrush}"
              TextElement.Foreground="{DynamicResource StatusNeutralForegroundBrush}">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" Text="&#xE823;" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Seated">
          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusSeatedBackgroundBrush}" />
          <Setter TargetName="Pill" Property="TextElement.Foreground" Value="{DynamicResource StatusSeatedForegroundBrush}" />
          <Setter TargetName="Icon" Property="Text" Value="&#xE716;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="InProgress">
          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusReviewBackgroundBrush}" />
          <Setter TargetName="Pill" Property="TextElement.Foreground" Value="{DynamicResource StatusReviewForegroundBrush}" />
          <Setter TargetName="Icon" Property="Text" Value="&#xE768;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Completed">
          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusCompletedBackgroundBrush}" />
          <Setter TargetName="Pill" Property="TextElement.Foreground" Value="{DynamicResource StatusCompletedForegroundBrush}" />
          <Setter TargetName="Icon" Property="Text" Value="&#xE73E;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Postponed">
          <Setter TargetName="Icon" Property="Text" Value="&#xE769;" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The queue: two lines per youth, time or status on the right. -->
    <DataTemplate x:Key="QueueItem" DataType="{x:Type app:ScoutRow}">
      <DockPanel Margin="0,6">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
          <ContentControl x:Name="Pill" Content="{Binding}" ContentTemplate="{StaticResource StatusCell}" HorizontalAlignment="Right" Focusable="False" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding TimeText}" HorizontalAlignment="Right" ToolTip="{Binding MinsTip}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding FullName}" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding SubLine}" ToolTip="{Binding RegNumTip}" />
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding QueueRank}" Value="0">
          <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="RoomItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Width" Value="200" />
      <Setter Property="MinHeight" Value="112" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="ToolTip" Value="{Binding TimerTip}" />
      <Setter Property="ToolTipService.IsEnabled" Value="{Binding HasTimerTip}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Padding="{TemplateBinding Padding}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                <Setter TargetName="Card" Property="Padding" Value="11" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="RoomCardTemplate" DataType="{x:Type app:RoomCard}">
      <StackPanel>
        <DockPanel>
          <!-- The minutes with a clock per state (SPEC.md D-13): a stopwatch on
               time, a timer clock on an orange tint running long, an alarm
               clock on a solid fill overdue. Segoe Fluent Icons has no timer or
               alarm clock; Segoe UI Symbol's monochrome ones take the palette. -->
          <Border x:Name="Timer" DockPanel.Dock="Right" VerticalAlignment="Top" Padding="5,0" Margin="8,0,0,0"
                  CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="Transparent"
                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Clock" FontFamily="Segoe UI Symbol" FontSize="13" Text="&#x23F1;" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TimerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
            <Run Text="Room" /> <Run Text="{Binding Room, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{Binding BoardTypeText}" />
        <TextBlock x:Name="Scout" Text="{Binding ScoutText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <!-- One member per line, in full: this is how people find which room someone is in. -->
        <TextBlock Style="{StaticResource Hint}" Text="{Binding LeadersLines}" Margin="0,2,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsFree}" Value="True">
          <Setter TargetName="Scout" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TimerState}" Value="None">
          <Setter TargetName="Timer" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TimerState}" Value="Warning">
          <Setter TargetName="Timer" Property="Background" Value="{DynamicResource TimerLongBackgroundBrush}" />
          <Setter TargetName="Timer" Property="BorderBrush" Value="{DynamicResource StatusBorderBrush}" />
          <Setter TargetName="Timer" Property="TextElement.Foreground" Value="{DynamicResource TimerLongForegroundBrush}" />
          <Setter TargetName="Clock" Property="Text" Value="&#x23F2;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TimerState}" Value="Overdue">
          <Setter TargetName="Timer" Property="Background" Value="{DynamicResource TimerOverdueBackgroundBrush}" />
          <Setter TargetName="Timer" Property="BorderBrush" Value="{DynamicResource StatusBorderBrush}" />
          <Setter TargetName="Timer" Property="TextElement.Foreground" Value="{DynamicResource TimerOverdueForegroundBrush}" />
          <Setter TargetName="Clock" Property="Text" Value="&#x23F0;" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- An adult's name with the marks after it (SPEC.md D-20): Wood Badge,
         and a warning when they're in the youth's own unit. The marks sit in
         the name's line, so they follow the last word when a name wraps. -->
    <DataTemplate x:Key="AdultName" DataType="{x:Type app:PickRow}">
      <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><app:AdultMarks
        WoodBadge="{Binding WoodBadge, Mode=OneWay}" SameUnitAs="{Binding SameUnitAs, Mode=OneWay}" /></InlineUIContainer></TextBlock>
    </DataTemplate>

    <!-- An adult as a choice in Replace and Add member: the name, the marks, then unit and role. -->
    <DataTemplate x:Key="AdultChoice" DataType="{x:Type app:PickRow}">
      <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><app:AdultMarks
        WoodBadge="{Binding WoodBadge, Mode=OneWay}" SameUnitAs="{Binding SameUnitAs, Mode=OneWay}" /></InlineUIContainer><Run
        Text="{Binding Detail, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
    </DataTemplate>

    <!-- A picked member in the builder: who, and the chair choice. -->
    <DataTemplate x:Key="PickTemplate" DataType="{x:Type app:PickRow}">
      <Border Padding="12,8" Margin="0,0,0,4" CornerRadius="{DynamicResource ControlCornerRadius}"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Click="OnRemovePick" Tag="{Binding}" Padding="6" Margin="8,0,0,0" VerticalAlignment="Center"
                  ToolTip="Remove from this board" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE711;" />
          </Button>
          <RadioButton DockPanel.Dock="Right" GroupName="Chair" Content="Chair" IsChecked="{Binding IsChair}" VerticalAlignment="Center"
                       MinWidth="0" Visibility="{Binding CanChair, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.Name="{Binding Name, StringFormat={}{0} chairs}" />
          <StackPanel VerticalAlignment="Center">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AdultName}" Focusable="False" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- An adult who could join the board. -->
    <DataTemplate x:Key="AvailableTemplate" DataType="{x:Type app:PickRow}">
      <DockPanel Margin="0,4">
        <Button DockPanel.Dock="Right" Click="OnAddPick" Tag="{Binding}" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Name, StringFormat=Add {0}}">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE710;" Margin="0,0,6,0" /><TextBlock Text="Add" /></StackPanel>
        </Button>
        <StackPanel VerticalAlignment="Center">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AdultName}" Focusable="False" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>

    <!-- A member of a seated or running board: replace or remove them. -->
    <DataTemplate x:Key="SeatedMemberTemplate" DataType="{x:Type app:PickRow}">
      <Border Padding="12,8" Margin="0,0,0,4" CornerRadius="{DynamicResource ControlCornerRadius}"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Click="OnRemoveMember" Tag="{Binding}" Padding="6" Margin="8,0,0,0" VerticalAlignment="Center"
                  ToolTip="Take them off this board" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0} from the board}">
            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE711;" />
          </Button>
          <Button DockPanel.Dock="Right" Click="OnReplaceMember" Tag="{Binding}" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                  ToolTip="Swap in someone else" AutomationProperties.Name="{Binding Name, StringFormat=Replace {0}}">
            <TextBlock Text="Replace..." />
          </Button>
          <StackPanel VerticalAlignment="Center">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AdultName}" Focusable="False" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" />
            <TextBlock Style="{StaticResource Hint}" Text="Chairing this board" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       Visibility="{Binding IsChair, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- A label over its value, for the details pane. -->
    <DataTemplate x:Key="FactTemplate">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Style="{StaticResource Hint}" Text="{Binding Key}" />
        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style x:Key="PeopleRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBusy}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- The menu bar: the pages, the windows beside them, Settings, Help and
         Donate (SPEC.md P-1, P-6, D-17). No sidebar: the Event page has the
         window's whole width. Every command here also has a shortcut or a
         button where the operator works. -->
    <Menu DockPanel.Dock="Top" Margin="4,4,4,4" AutomationProperties.Name="Menu bar">
      <MenuItem Header="_File">
        <MenuItem Header="_Save report..." InputGestureText="Ctrl+S" Click="OnReport" ToolTip="Save the event's results as a CSV file for Excel">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Admin tables..." Click="OnAdmin" ToolTip="View and edit every record, including roles">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Check-in _QR code..." Click="OnShowQr" ToolTip="Show the check-in address as a QR code for a tablet's camera">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Se_ttings..." InputGestureText="Ctrl+," Click="OnSettings" ToolTip="Room timers, and about this app">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoMenu" Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo" IsEnabled="False">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ViewEvent" Header="_Event" InputGestureText="Ctrl+1" Tag="Event" Click="OnViewPage"
                  ToolTip="The event's youth, rooms and boards" />
        <MenuItem x:Name="ViewResults" Header="_Results" InputGestureText="Ctrl+2" Tag="Results" Click="OnViewPage"
                  ToolTip="Every board and its result, and the report" />
        <MenuItem x:Name="ViewPeople" Header="_People" InputGestureText="Ctrl+3" Tag="People" Click="OnViewPage"
                  ToolTip="The adults signed in at this event" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Eagle Boards _help" InputGestureText="F1" Click="OnHelp" ToolTip="How to run an event">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE897;" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- SPEC.md D-17: the way to the Support card, in the window's frame,
             never in the queue, the rooms or the details pane. -->
        <MenuItem Header="_Donate..." Click="OnDonate" ToolTip="Ways to support this project">
          <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xEB51;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Content layer -->
    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <DockPanel>
        <!-- Where the check-in stations should point. -->
        <!-- Docked, not a StatusBar: its last item only gets what's left, so a
             long data path pushed the others off the edge. The path gives way.
             No clock: the taskbar has one, and no Undo: Edit › Undo and Ctrl+Z
             have it. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="16,6,16,8" LastChildFill="True">
          <TextBlock x:Name="ImportText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Margin="16,0,0,0" VerticalAlignment="Center" />
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="UrlLabel" Text="Check-in address: " VerticalAlignment="Center" />
            <ItemsControl x:Name="UrlList" VerticalAlignment="Center" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,0,16,0">
                    <Hyperlink NavigateUri="{Binding}" RequestNavigate="OnUrlClicked" ToolTip="Open in a browser. Right-click to copy.">
                      <Hyperlink.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy address" Click="OnCopyUrl" Tag="{Binding}" />
                        </ContextMenu>
                      </Hyperlink.ContextMenu>
                      <Run Text="{Binding Mode=OneWay}" />
                    </Hyperlink>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="CopiedText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="QrButton" Click="OnShowQr" Padding="8,2" VerticalAlignment="Center" ToolTip="Show the check-in address as a QR code for a tablet's camera">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE722;" Margin="0,0,6,0" /><TextBlock Text="QR code..." /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="DataText" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Messages about the event as a whole (the import, the report). -->
        <app:InfoBar x:Name="Notice" DockPanel.Dock="Top" Margin="16,16,16,0" IsClosable="True" />

        <Grid>
          <!-- ============================= Event ============================== -->
          <Grid x:Name="EventPage" Margin="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" MinWidth="240" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- The queue: every youth, stacked Waiting, On a board, Finished
                 (SPEC.md O-3). No find of its own: Find a person, over the
                 rooms, says where anyone is (D-21). -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,12,4,12">
              <DockPanel>
                <!-- As tall as the Rooms card's command row, so the two titles line up. -->
                <Grid DockPanel.Dock="Top" MinHeight="32" Margin="0,0,8,4">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Youth" />
                </Grid>
                <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource QueueItem}" Padding="0,0,8,0"
                         SelectionChanged="OnQueueSelected" PreviewMouseLeftButtonDown="OnQueueClick" AutomationProperties.Name="Youth"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                      <Setter Property="AutomationProperties.Name" Value="{Binding FullName}" />
                      <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusText}" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource Hint}" Margin="4,12,0,4">
                            <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" />
                          </TextBlock>
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                </ListBox>
              </DockPanel>
            </Border>

            <!-- The rooms -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CommandButton}" Click="OnAddRoom" ToolTip="Add a room">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" /><TextBlock Text="Add room" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="OnChangeRoom" ToolTip="Move the selected room's board to another room, or swap two boards">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" Margin="0,0,8,0" /><TextBlock Text="Move" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="OnRenameRoom" ToolTip="Rename the selected room"
                            AutomationProperties.Name="Rename room">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;" />
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="OnSwitchRoomType" ToolTip="Switch the selected room between final boards and project reviews"
                            AutomationProperties.Name="Switch room type">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Margin="0" Click="OnRemoveRoom" ToolTip="Remove the selected room"
                            AutomationProperties.Name="Remove room">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                  </StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="Rooms" />
                </DockPanel>
                <!-- Which room is someone in (SPEC.md D-21)? A youth's or an
                     adult's name, or a room, narrows the rooms to theirs; for
                     anyone in no room, the note beside it says where they are. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <TextBox x:Name="PersonFind" app:Placeholder.Text="Find a person" DockPanel.Dock="Left" Width="280" VerticalAlignment="Top"
                           VerticalContentAlignment="Center" TextChanged="OnPersonFind" PreviewKeyDown="OnPersonFindKey"
                           AutomationProperties.Name="Find a person"
                           ToolTip="Type a youth's or an adult's name to see which room they're in. Enter opens the room's board; Esc clears." />
                  <TextBlock x:Name="PersonFindNote" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="12,6,0,0"
                             VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
                <ListBox x:Name="RoomList" SelectionMode="Single" SelectionChanged="OnRoomSelected"
                         ItemContainerStyle="{StaticResource RoomItem}" ItemTemplate="{StaticResource RoomCardTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Rooms">
                  <!-- On the list, not in the item style (WPF can't wire handlers there);
                       right-clicking a room selects it first, so these act on that room. -->
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="_Move or swap board..." Click="OnChangeRoom" />
                      <MenuItem Header="_Rename..." Click="OnRenameRoom" />
                      <MenuItem Header="S_witch type" Click="OnSwitchRoomType" />
                      <MenuItem Header="_Remove room" Click="OnRemoveRoom" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </DockPanel>
            </Border>

            <!-- The selected youth's board -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel x:Name="Details">
                  <StackPanel x:Name="DetailsEmpty" Margin="0,48,0,0">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="32" Text="&#xE716;" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Select a youth to build their board, or a room to see who's in it." />
                  </StackPanel>

                  <StackPanel x:Name="DetailsHead" Visibility="Collapsed">
                    <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailSub" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <ContentControl x:Name="DetailStatus" ContentTemplate="{StaticResource StatusCell}" HorizontalAlignment="Left" Focusable="False" />
                    <app:InfoBar x:Name="DetailNotice" Margin="0,12,0,0" IsClosable="True" />
                  </StackPanel>

                  <!-- Waiting: build the board -->
                  <StackPanel x:Name="BuilderSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Room" />
                    <ComboBox x:Name="BuilderRoom" DisplayMemberPath="Value" SelectedValuePath="Key" HorizontalAlignment="Stretch"
                              SelectionChanged="OnBuilderRoomChanged" AutomationProperties.Name="Room" />

                    <DockPanel Margin="0,16,0,4">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="FillButton" Click="OnFillBoard" Padding="8,2" Margin="0,0,8,0"
                                ToolTip="Keep the members you've chosen and add a chair and members to complete the board">
                          <TextBlock Text="Fill the rest" />
                        </Button>
                        <Button Click="OnClearPicks" Padding="8,2" ToolTip="Remove everyone and propose a new board">
                          <TextBlock Text="Start over" />
                        </Button>
                      </StackPanel>
                      <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Board members" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="To choose someone yourself, remove who you don't want and add them from the list below. Fill the rest completes the board around your choices." />
                    <ItemsControl x:Name="PickList" ItemTemplate="{StaticResource PickTemplate}" Focusable="False" AutomationProperties.Name="Board members" />
                    <TextBlock x:Name="NoPicksText" Style="{StaticResource Hint}" Text="No one yet. Add members below." Margin="0,0,0,4" />

                    <StackPanel x:Name="IssueList" Margin="0,8,0,0" />

                    <WrapPanel Margin="0,8,0,0">
                      <Button x:Name="SeatButton" Style="{StaticResource PrimaryCommandButton}" Click="OnSeat"
                              ToolTip="The members go to the room to read the application, references and workbook. The youth waits outside until Start review.">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE716;" Margin="0,0,8,0" /><AccessText x:Name="SeatText" Text="_Seat board" /></StackPanel>
                      </Button>
                      <Button x:Name="PostponeButton" Style="{StaticResource CommandButton}" Click="OnPostpone"
                              ToolTip="No board at this event, usually because the paperwork isn't in order">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" Margin="0,0,8,0" /><AccessText Text="_Postpone..." /></StackPanel>
                      </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="Add members" Margin="0,24,0,8" />
                    <TextBox x:Name="AvailableFilter" app:Placeholder.Text="Find an adult" TextChanged="OnAvailableFilter" AutomationProperties.Name="Find an adult"
                             ToolTip="Find an adult by name or unit" Margin="0,0,0,8" />
                    <ItemsControl x:Name="AvailableList" ItemTemplate="{StaticResource AvailableTemplate}" Focusable="False"
                                  AutomationProperties.Name="Adults who can join" />
                    <TextBlock x:Name="NoAvailableText" Style="{StaticResource Hint}" Text="No other adults are free for this board." />
                  </StackPanel>

                  <!-- Seated, in review, or finished -->
                  <StackPanel x:Name="BoardSection" Visibility="Collapsed">
                    <ItemsControl x:Name="FactList" ItemTemplate="{StaticResource FactTemplate}" Margin="0,16,0,0" Focusable="False" />

                    <!-- Someone has to leave mid-board: change the members here. -->
                    <StackPanel x:Name="MembersSection">
                      <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Board members" Margin="0,0,0,8" />
                      <ItemsControl x:Name="BoardMemberList" ItemTemplate="{StaticResource SeatedMemberTemplate}" Focusable="False"
                                    AutomationProperties.Name="Board members" />
                      <WrapPanel Margin="0,4,0,16">
                        <Button Style="{StaticResource CommandButton}" Click="OnAddMember" ToolTip="Add someone to this board">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" /><TextBlock Text="Add member..." /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource CommandButton}" Click="OnChangeChair" ToolTip="Hand the chair to another qualified member">
                          <TextBlock Text="Change chair..." />
                        </Button>
                      </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="ResultSection">
                      <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Result" Margin="0,4,0,8" />
                      <StackPanel x:Name="ResultChoices" />
                      <TextBlock Text="Notes" Margin="0,12,0,8" />
                      <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalContentAlignment="Top"
                               VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notes" />
                    </StackPanel>

                    <WrapPanel Margin="0,16,0,0">
                      <Button x:Name="StartButton" Style="{StaticResource PrimaryCommandButton}" Click="OnStart"
                              ToolTip="Bring the youth in once the members have finished reading. Reset undoes it.">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0" /><AccessText Text="Sta_rt review" /></StackPanel>
                      </Button>
                      <Button x:Name="CompleteButton" Style="{StaticResource PrimaryCommandButton}" Click="OnComplete"
                              ToolTip="Record the result and free the room and its members">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,0,8,0" /><AccessText Text="_Complete" /></StackPanel>
                      </Button>
                      <Button x:Name="ResetButton" Style="{StaticResource CommandButton}" Click="OnReset" ToolTip="Undo the seating: back to waiting, room and members freed">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" Margin="0,0,8,0" /><AccessText Text="Rese_t..." /></StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>

                  <!-- Where their people are: for fetching them, and after the board. -->
                  <StackPanel x:Name="LocateSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Leaders and parents" Margin="0,24,0,8" />
                    <ItemsControl x:Name="LocateList" ItemTemplate="{StaticResource FactTemplate}" Focusable="False" />
                    <TextBlock x:Name="LocateNone" Style="{StaticResource Hint}" />
                    <!-- For the adult who came with this youth but didn't say so at sign-in. -->
                    <WrapPanel Margin="0,8,0,0">
                      <Button Style="{StaticResource CommandButton}" Click="OnLinkAdult"
                              ToolTip="Someone who came to support this youth but didn't say so at sign-in">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" Margin="0,0,8,0" /><TextBlock Text="Link an adult..." /></StackPanel>
                      </Button>
                      <Button x:Name="UnlinkButton" Style="{StaticResource CommandButton}" Click="OnUnlinkAdult" ToolTip="Remove a supporting adult's link to this youth">
                        <TextBlock Text="Unlink..." />
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- ============================ Results ============================ -->
          <DockPanel x:Name="ResultsPage" Margin="16" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox x:Name="BoardFilter" app:Placeholder.Text="Find a board" Style="{StaticResource SearchBox}" Margin="0,0,8,0" TextChanged="OnBoardFilter"
                         AutomationProperties.Name="Find a board" ToolTip="Find a board by name, unit, member or result" />
                <Button Style="{StaticResource CommandButton}" Click="OnReport" ToolTip="Save the event's results as a CSV file for Excel">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" Margin="0,0,8,0" /><TextBlock Text="Save report..." /></StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Margin="0" Click="OnAdmin" ToolTip="View and edit every record">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Margin="0,0,8,0" /><TextBlock Text="Admin tables..." /></StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="Results" />
            </DockPanel>
            <Border Style="{StaticResource Card}">
              <DataGrid x:Name="BoardGrid" IsReadOnly="True" AutomationProperties.Name="Boards at this event" MouseDoubleClick="OnBoardOpened"
                        ToolTip="Double-click a board to open it on the Event page">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Sign-in" Binding="{Binding RegNum}" SortMemberPath="RegNumSort" Width="72" />
                  <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="110" />
                  <DataGridTextColumn Header="First" Binding="{Binding First}" Width="100" />
                  <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" SortMemberPath="UnitName" Width="96" />
                  <DataGridTextColumn Header="Board" Binding="{Binding BoardType}" Width="76" />
                  <DataGridTemplateColumn Header="Status" CellTemplate="{StaticResource StatusCell}" SortMemberPath="StatusRank" Width="128" />
                  <DataGridTextColumn Header="Room" Binding="{Binding RoomText}" SortMemberPath="Room" Width="68" />
                  <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" SortMemberPath="Result" Width="110" />
                  <DataGridTextColumn Header="Chair" Binding="{Binding BoardChair}" Width="160" />
                  <DataGridTextColumn Header="Members" Binding="{Binding BoardMembersText}" SortMemberPath="BoardMembers" Width="280" />
                  <DataGridTextColumn Header="Leader" Binding="{Binding Leader}" Width="150" />
                  <!-- No star column: DataGrid would squeeze the others to fit it; this scrolls instead. -->
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="320" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>

          <!-- ============================ People ============================ -->
          <DockPanel x:Name="PeoplePage" Margin="16" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBox x:Name="AdultFilter" app:Placeholder.Text="Find an adult" Style="{StaticResource SearchBox}" Margin="0,0,8,0" TextChanged="OnAdultFilter"
                         AutomationProperties.Name="Find an adult" ToolTip="Find an adult by name, unit, room or role" />
                <Button x:Name="DisableButton" Style="{StaticResource CommandButton}" Click="OnDisableAdult" ToolTip="The selected adult has gone home">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" Margin="0,0,8,0" /><TextBlock Text="Gone home" /></StackPanel>
                </Button>
                <Button x:Name="EnableButton" Style="{StaticResource CommandButton}" Click="OnEnableAdult" ToolTip="The selected adult is back and available">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FA;" Margin="0,0,8,0" /><TextBlock Text="Back" /></StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Margin="0" Click="OnAdmin" ToolTip="View and edit every record, including roles">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Margin="0,0,8,0" /><TextBlock Text="Admin tables..." /></StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Style="{StaticResource PageTitle}" Text="People" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Adults signed in at this event. Change someone's roles on the admin tables." />
            <Border Style="{StaticResource Card}">
              <DataGrid x:Name="AdultGrid" IsReadOnly="True" RowStyle="{StaticResource PeopleRowStyle}" SelectionChanged="OnAdultSelected"
                        AutomationProperties.Name="Adults">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="140" />
                  <DataGridTextColumn Header="First" Binding="{Binding First}" Width="130" />
                  <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" SortMemberPath="UnitName" Width="110" />
                  <DataGridTextColumn Header="Room" Binding="{Binding RoomText}" SortMemberPath="Room" Width="110" />
                  <DataGridTextColumn Header="Final board role" Binding="{Binding FinalBoard}" Width="140" />
                  <DataGridTextColumn Header="Project review role" Binding="{Binding ProjectReview}" Width="160" />
                  <!-- Volunteering toward a Wood Badge ticket item: the mark (SPEC.md D-20), sorted on the field. -->
                  <DataGridTemplateColumn Header="Wood Badge" SortMemberPath="WoodBadge" Width="104">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type app:AdultRow}">
                        <app:AdultMarks WoodBadge="{Binding IsWoodBadge, Mode=OneWay}" HorizontalAlignment="Left" Margin="-6,0,0,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Came to support" Binding="{Binding SupportingNames}" Width="*" MinWidth="160" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
