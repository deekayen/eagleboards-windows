<Window x:Class="EagleBoards.App.MainWindow"
        Icon="/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EagleBoards.App"
        Title="Eagle Board Scheduler" Width="1400" Height="900" MinWidth="900" MinHeight="600"
        WindowState="Maximized" FontSize="13" Background="#F4F3EF">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Cells take their colors from the row, including when selected, so the
         status colors (and their "Hi" variants) are what marks the selection
         rather than the system highlight. -->
    <Style x:Key="PlainCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ScoutRowStyle" TargetType="DataGridRow">
      <Setter Property="Background" Value="{Binding Background}" />
      <Setter Property="Foreground" Value="Black" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{Binding SelectedBackground}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AdultRowStyle" TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{Binding Foreground}" />
      <Setter Property="Background" Value="White" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter Property="Background" Value="#E8F0FE" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#D2E3FC" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PanelToolbar" TargetType="WrapPanel">
      <Setter Property="Margin" Value="4,4,4,4" />
    </Style>

    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Background" Value="{StaticResource PanelBorder}" />
    </Style>
  </Window.Resources>

  <Grid>
    <DockPanel>

      <Menu DockPanel.Dock="Top" Padding="2" Background="#FBFAF7">
        <MenuItem Header="_File">
          <MenuItem Header="Save _Report..." ToolTip="Save the evening's board results as a CSV file" Click="OnReport" />
          <MenuItem Header="Open _Check-in Page" ToolTip="Open the sign-in website in a browser on this computer" Click="OnOpenCheckIn" />
          <Separator />
          <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Refresh" InputGestureText="F5" Click="OnRefresh" />
          <MenuItem Header="_Admin Tables..." ToolTip="View and edit every record: youth, adults, adult history, rooms" Click="OnAdmin" />
        </MenuItem>
        <MenuItem Header="R_ooms">
          <MenuItem Header="_Add Room..." Click="OnAddRoom" />
          <MenuItem Header="_Remove Room" ToolTip="Remove the selected room" Click="OnRemoveRoom" />
          <MenuItem Header="_Change Room..." ToolTip="Move or swap the selected room's board with another room" Click="OnChangeRoom" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="_Settings..." ToolTip="Timers and status colors" Click="OnSettings" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="Scheduler _Help" InputGestureText="F1" Click="OnHelp" />
        </MenuItem>
      </Menu>

      <!-- Toolbar: the things used all evening -->
      <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,1" Background="#FBFAF7">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="Eagle Board Scheduler" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0" />
          <WrapPanel>
            <Button Style="{StaticResource ToolButton}" Content="Refresh" ToolTip="Reload everything now (F5)" Click="OnRefresh" />
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource ToolButton}" Content="+ Room" ToolTip="Add a room" Click="OnAddRoom" />
            <Button Style="{StaticResource ToolButton}" Content="- Room" ToolTip="Remove the selected room" Click="OnRemoveRoom" />
            <Button Style="{StaticResource ToolButton}" Content="Change Room" ToolTip="Move or swap the selected room's board with another room" Click="OnChangeRoom" />
          </WrapPanel>
        </DockPanel>
      </Border>

      <!-- Status bar: where the check-in stations should point -->
      <Border DockPanel.Dock="Bottom" Padding="10,4" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Background="#FBFAF7">
        <DockPanel>
          <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Foreground="#555" Margin="16,0,0,0" />
          <TextBlock x:Name="ImportText" DockPanel.Dock="Right" Foreground="#555" Margin="16,0,0,0" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Check-in stations: " FontWeight="SemiBold" VerticalAlignment="Center" />
            <ItemsControl x:Name="UrlList" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,0,14,0">
                    <Hyperlink NavigateUri="{Binding}" RequestNavigate="OnUrlClicked" ToolTip="Click to open; right-click to copy">
                      <Hyperlink.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy address" Click="OnCopyUrl" Tag="{Binding}" />
                        </ContextMenu>
                      </Hyperlink.ContextMenu>
                      <Run Text="{Binding Mode=OneWay}" />
                    </Hyperlink>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DataText" Foreground="#555" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="4*" MinHeight="120" />
          <RowDefinition Height="8" />
          <RowDefinition Height="2*" MinHeight="110" />
          <RowDefinition Height="8" />
          <RowDefinition Height="3*" MinHeight="100" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="260" />
          </Grid.ColumnDefinitions>

          <!-- Youth -->
          <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitle}">
                <DockPanel>
                  <TextBox x:Name="ScoutFilter" DockPanel.Dock="Right" Width="140" VerticalContentAlignment="Center" TextChanged="OnScoutFilter"
                           ToolTip="Show only rows containing this text" />
                  <TextBlock DockPanel.Dock="Right" Text="Filter " VerticalAlignment="Center" />
                  <TextBlock Text="Youth" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <WrapPanel DockPanel.Dock="Top" Style="{StaticResource PanelToolbar}">
                <Button x:Name="SeatButton" Style="{StaticResource ActionButton}" Content="_Seat Board" Click="OnSeat"
                        ToolTip="Put the board members in a room to read the application, references and project workbook. The scout stays outside until Start Review." />
                <Button x:Name="StartButton" Style="{StaticResource ActionButton}" Content="Start Re_view" Click="OnStart"
                        ToolTip="Bring the scout into the room and begin the interview, once the members have finished reading." />
                <Button x:Name="CompleteButton" Style="{StaticResource ActionButton}" Content="_Complete" Click="OnComplete"
                        ToolTip="Finish the review and record the result. Available once the scout has been brought in." />
                <Border Style="{StaticResource Sep}" />
                <Button x:Name="LocateButton" Style="{StaticResource ToolButton}" Content="_Locate" Click="OnLocate" ToolTip="Where are this scout's leaders and parents?" />
                <Button x:Name="ResetButton" Style="{StaticResource ToolButton}" Content="Reset" Click="OnReset" ToolTip="Undo the seating: back to Registered, room and members freed" />
                <Button x:Name="PostponeButton" Style="{StaticResource ToolButton}" Content="Postpone" Click="OnPostpone" ToolTip="Postpone this scout's board (e.g. paperwork not in order)" />
                <Border Style="{StaticResource Sep}" />
                <ToggleButton x:Name="ShowFinishedToggle" Content="Show finished" Padding="8,3" Margin="2,0" Click="OnScoutViewToggle"
                              ToolTip="Also list Completed and Postponed youth" />
              </WrapPanel>
              <DataGrid x:Name="ScoutGrid" IsReadOnly="True" CellStyle="{StaticResource PlainCell}" RowStyle="{StaticResource ScoutRowStyle}"
                        SelectionChanged="OnScoutSelected" PreviewMouseLeftButtonDown="OnScoutGridClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding RegNum}" SortMemberPath="RegNumSort" Width="46">
                    <DataGridTextColumn.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainCell}">
                        <Setter Property="ToolTip" Value="{Binding RegNumTip}" />
                      </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader">
                        <Setter Property="ToolTip" Value="P = pre-registered (matched a sign-up), W = walk-in. The number is the order they signed in within their group. Pre-registered sort first." />
                      </Style>
                    </DataGridTextColumn.HeaderStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Min" Binding="{Binding Mins}" Width="44">
                    <DataGridTextColumn.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainCell}">
                        <Setter Property="ToolTip" Value="{Binding MinsTip}" />
                      </Style>
                    </DataGridTextColumn.CellStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="100" />
                  <DataGridTextColumn Header="First" Binding="{Binding First}" Width="90" />
                  <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" SortMemberPath="UnitName" Width="64" />
                  <DataGridTextColumn Header="F/P" Binding="{Binding BoardType}" Width="60" />
                  <DataGridTextColumn Header="RM#" Binding="{Binding Room}" Width="52" />
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="StatusRank" Width="84" />
                  <DataGridTextColumn Header="Leader" Binding="{Binding Leader}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

          <!-- Adults -->
          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitle}">
                <DockPanel>
                  <TextBox x:Name="AdultFilter" DockPanel.Dock="Right" Width="140" VerticalContentAlignment="Center" TextChanged="OnAdultFilter"
                           ToolTip="Show only rows containing this text" />
                  <TextBlock DockPanel.Dock="Right" Text="Filter " VerticalAlignment="Center" />
                  <TextBlock Text="Adult Board Members" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <WrapPanel DockPanel.Dock="Top" Style="{StaticResource PanelToolbar}">
                <ToggleButton x:Name="ShowAllAdultsToggle" Content="Show all" Padding="8,3" Margin="2,0" Click="OnAdultViewToggle"
                              ToolTip="Also list adults already on a board, gone home, or unavailable for final boards" />
                <Button Style="{StaticResource ToolButton}" Content="Clear picks" Click="OnClearPicks" ToolTip="Untick every adult" />
                <Border Style="{StaticResource Sep}" />
                <Button x:Name="EnableButton" Style="{StaticResource ToolButton}" Content="Enable" Click="OnEnableAdult" ToolTip="The selected adult is back and available" />
                <Button x:Name="DisableButton" Style="{StaticResource ToolButton}" Content="Disable" Click="OnDisableAdult" ToolTip="The selected adult has gone home for tonight" />
                <TextBlock x:Name="PickCount" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555" />
              </WrapPanel>
              <DataGrid x:Name="AdultGrid" CellStyle="{StaticResource PlainCell}" RowStyle="{StaticResource AdultRowStyle}"
                        SelectionChanged="OnAdultSelected">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="@" SortMemberPath="SelSort" Width="36" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Sel, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanPick}"
                                  ToolTip="{Binding PickTip}" ToolTipService.ShowOnDisabled="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="100" IsReadOnly="True" />
                  <DataGridTextColumn Header="First" Binding="{Binding First}" Width="90" IsReadOnly="True" />
                  <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" SortMemberPath="UnitName" Width="64" IsReadOnly="True" />
                  <DataGridTextColumn Header="RM#" Binding="{Binding Room}" Width="52" IsReadOnly="True" />
                  <DataGridTextColumn Header="Final" Binding="{Binding FinalBoard}" Width="84" IsReadOnly="True" />
                  <DataGridTextColumn Header="Project" Binding="{Binding ProjectReview}" Width="*" IsReadOnly="True" />
                  <!-- Volunteering toward a Wood Badge ticket item. -->
                  <DataGridTextColumn Header="WB" Binding="{Binding WoodBadgeMark}" SortMemberPath="WoodBadge" Width="36" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Rooms -->
        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitle}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Text="Filter " VerticalAlignment="Center" />
                  <TextBox x:Name="RoomFilter" Width="140" VerticalContentAlignment="Center" TextChanged="OnRoomFilter" />
                  <Button Content="Clear" Padding="8,0" Margin="4,0,0,0" Click="OnClearRoomFilter" />
                </StackPanel>
                <TextBlock Text="Rooms" FontWeight="Bold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6">
              <ItemsControl x:Name="RoomList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type app:RoomCard}">
                    <Border x:Name="Card" Width="210" Margin="0,0,6,0" Padding="8,6" CornerRadius="3" BorderThickness="1"
                            BorderBrush="#CBD8E4" Background="#E9E9E4" Cursor="Hand" MouseLeftButtonUp="OnRoomCardClicked">
                      <StackPanel>
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding TimerText}" Foreground="{Binding TimerBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text=" &#x26A0;" Foreground="{Binding TimerBrush}" FontSize="14"
                                       Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                          <TextBlock FontSize="14">
                            <Run Text="RM: " /><Run Text="{Binding Room, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{Binding BoardType, Mode=OneWay, StringFormat=({0})}" Foreground="#555" />
                          </TextBlock>
                        </DockPanel>
                        <TextBlock TextTrimming="CharacterEllipsis" Margin="0,2,0,0" FontSize="14">
                          <Run Text="S: " /><Run Text="{Binding Scout, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                          <Run Text="L: " /><Run Text="{Binding LeadersText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="#FFFF99" />
                        <Setter TargetName="Card" Property="BorderBrush" Value="#B6B0A4" />
                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Boards -->
        <Border Grid.Row="4" Style="{StaticResource Panel}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitle}">
              <DockPanel>
                <TextBox x:Name="BoardFilter" DockPanel.Dock="Right" Width="140" VerticalContentAlignment="Center" TextChanged="OnBoardFilter"
                         ToolTip="Show only rows containing this text" />
                <TextBlock DockPanel.Dock="Right" Text="Filter " VerticalAlignment="Center" />
                <TextBlock Text="Active and Completed Boards" FontWeight="Bold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <DataGrid x:Name="BoardGrid" IsReadOnly="True" CellStyle="{StaticResource PlainCell}" RowStyle="{StaticResource ScoutRowStyle}"
                      SelectionChanged="OnBoardSelected">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RegNum}" SortMemberPath="RegNumSort" Width="46" />
                <DataGridTextColumn Header="Last" Binding="{Binding Last}" Width="100" />
                <DataGridTextColumn Header="First" Binding="{Binding First}" Width="90" />
                <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" SortMemberPath="UnitName" Width="64" />
                <DataGridTextColumn Header="Leader" Binding="{Binding Leader}" Width="110" />
                <DataGridTextColumn Header="Board" Binding="{Binding BoardType}" Width="60" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="StatusRank" Width="84" />
                <DataGridTextColumn Header="RM#" Binding="{Binding Room}" Width="52" />
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                <DataGridTextColumn Header="Chair" Binding="{Binding BoardChair}" Width="150" />
                <DataGridTextColumn Header="Members" Binding="{Binding BoardMembersText}" SortMemberPath="BoardMembers" Width="240" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>

    <!-- Notices, top right, newest last. Click one to dismiss it. -->
    <ItemsControl x:Name="ToastList" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,52,14,0" Panel.ZIndex="10">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type app:Toast}">
          <Border Background="{Binding Background}" BorderBrush="#999" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                  Cursor="Hand" MouseLeftButtonUp="OnToastClicked">
            <Border.Effect>
              <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,2" />
              <ContentPresenter Content="{Binding Body}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
