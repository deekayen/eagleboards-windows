<Window x:Class="EagleBoards.App.StartupWindow"
        Icon="pack://application:,,,/EagleBoards;component/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EagleBoards.App"
        Title="Eagle Board Scheduler"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Command area, as at the foot of a Windows dialog. -->
    <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" IsDefault="True" MinWidth="120" Click="OnStart"><AccessText Text="_Start" /></Button>
          <Button Content="Cancel" IsCancel="True" MinWidth="120" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="ProgressText" Style="{StaticResource Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
      </DockPanel>
    </Border>

    <StackPanel Margin="24,20,24,24">
      <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Start an event" />
      <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                 Text="Choose where the data is kept and which network the check-in stations are on. The check-in website runs until you close the scheduler." />
      <app:InfoBar x:Name="StartNotice" Margin="0,16,0,0" IsClosable="True" />

      <StackPanel x:Name="Form">
        <Label Style="{StaticResource FieldLabel}" Content="_Data folder" Target="{Binding ElementName=DataFolderBox}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseDataFolder" />
          <TextBox x:Name="DataFolderBox" VerticalContentAlignment="Center" TextChanged="OnPathsChanged" AutomationProperties.Name="Data folder" />
        </DockPanel>
        <TextBlock Style="{StaticResource FieldHint}" Text="Holds the settings, the adult history, and a folder for each event named by its date." />

        <Label Style="{StaticResource FieldLabel}" Content="_Event date" Target="{Binding ElementName=EventDate}" />
        <StackPanel Orientation="Horizontal">
          <DatePicker x:Name="EventDate" Width="160" SelectedDateChanged="OnDateChanged" AutomationProperties.Name="Event date" />
          <TextBlock x:Name="EventFolderText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Label Style="{StaticResource FieldLabel}" Content="_Adult history" Target="{Binding ElementName=HistoryBox}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseHistory" />
          <TextBox x:Name="HistoryBox" VerticalContentAlignment="Center" TextChanged="OnPathsChanged" AutomationProperties.Name="Adult history" />
        </DockPanel>
        <TextBlock x:Name="HistoryStatus" Style="{StaticResource FieldHint}" />

        <Label Style="{StaticResource FieldLabel}" Content="Check-in _network" Target="{Binding ElementName=NetworkBox}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Rescan" Margin="8,0,0,0" Click="OnRescan" />
          <ComboBox x:Name="NetworkBox" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Check-in network" />
        </DockPanel>
        <TextBlock Style="{StaticResource FieldHint}"
                   Text="The venue Wi-Fi the check-in tablets or laptops use. Serving only that network keeps the site off virtual and VPN adapters." />

        <Label Style="{StaticResource FieldLabel}" Content="_Port" Target="{Binding ElementName=PortBox}" />
        <TextBox x:Name="PortBox" Width="96" HorizontalAlignment="Left" VerticalContentAlignment="Center" AutomationProperties.Name="Port" />

        <CheckBox x:Name="SugCheck" Margin="0,20,0,0" IsChecked="{x:Null}" Content="Import the event's sign-ups from _SignUpGenius" />
        <TextBlock x:Name="SugStatus" Style="{StaticResource FieldHint}" Margin="28,4,0,0" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
