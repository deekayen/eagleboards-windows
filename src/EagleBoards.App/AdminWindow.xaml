<Window x:Class="EagleBoards.App.AdminWindow"
        Icon="/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin tables - Eagle Board Scheduler" Width="1250" Height="760" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" FontSize="13" Background="#F4F3EF">
  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Foreground="#555" Margin="2,0,0,8" TextWrapping="Wrap"
               Text="Every record for tonight, plus the cumulative adult history. Double-click a cell to edit it; the change is saved when you leave the cell. Promote an adult to Chair here (Adults tab, Final or Project column)." />
    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged" />
  </DockPanel>
</Window>
