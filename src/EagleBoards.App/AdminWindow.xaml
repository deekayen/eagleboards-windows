<Window x:Class="EagleBoards.App.AdminWindow"
        Icon="pack://application:,,,/EagleBoards;component/Assets/EagleBoards.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EagleBoards.App"
        Title="Admin tables - Eagle Board Scheduler" Width="1250" Height="760" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="0,0,0,12" TextWrapping="Wrap"
               Text="Every record for this event, plus the adult history. Double-click a cell to change it; the change is saved when you leave the cell. Make someone a chair here (Adults, Final role or Project role)." />
    <app:InfoBar x:Name="Notice" DockPanel.Dock="Top" Margin="0,0,0,12" IsClosable="True" />
    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged" />
  </DockPanel>
</Window>
