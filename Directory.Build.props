<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- CalVer, like the Java project: YYYY.MM.DD of the release. CI overrides
         this with -p:Version=... when it publishes. -->
    <Version>0.1.0</Version>
    <Product>Review Board Scheduler</Product>
    <Company>Review Board Scheduler contributors</Company>
    <Copyright>Copyright 2026 David Norman. Apache License 2.0.</Copyright>
  </PropertyGroup>
</Project>
